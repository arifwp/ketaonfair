# Server-only application connection on your development branch
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection for reviewed migrations and explicit seed execution
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
# Fixed event identity, server-only. The street-demo seed uses this UUID.
BOOKING_EVENT_ID=479672ed-1562-4a89-a21a-09bbd7f96441
# Public browser map key. Set allowed origins in MapTiler Cloud before deployment.
VITE_MAPTILER_KEY=replace-with-your-application-map-key
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Integration tests require a separate disposable branch. Never use live/demo data.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
TEST_DATABASE_BRANCH_ID=
